rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function role(r) { return request.auth != null && request.auth.token.role == r; }
  function staff() { return role('admin') || role('employee') || role('entriesOperator'); }
  match /{document=**} { allow read, write: if role('admin'); }
  match /bookings/{id} {
   allow read, create, update, delete: if staff();
   match /gateEvents/{event} { allow read, create: if staff(); }
  }
  match /config/{id} { allow read: if staff(); allow write: if staff() && (id == 'parkingLive' || id == 'reservationStats'); }
  match /prices/{id} { allow read: if staff(); }
  match /lpr_events/{id} { allow read, create: if staff(); }
  match /lpr_whitelist/{id} { allow read: if staff(); }
 }
}
